{
    "permissions": {
    "allow": [
      "Edit",
      "Copy-Item",
      "Get-Item",
      "Grep",
      "Glob",
      "Read",
      "Bash",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(git:*)",
      "Bash(npm:*)",
      "Bash(cmake:*)",
      "Bash(ninja:*)",
      "Bash(python:*)",
      "Bash(cmd.exe:*)"
    ],
    "additionalDirectories": [
      "C:\\",
      "\\tmp",
      "C:\\s\\MS\\tools\\tools\\corpus",
      "C:\\tmp"
    ]
  },

  "workbench.colorTheme": "Default Dark+",

  "cmake.debugConfig": {
    "name": "CMake Debug",
    "type": "lldb",
    "request": "launch",
    "program": "${command:cmake.launchTargetPath}",
    "args": [],
    "cwd": "${workspaceFolder}",
    "externalConsole": false,
    "stopAtEntry": false
  },
  
  "emeraldwalk.runonsave": {
    "commands": [
      {
        "match": "\\.(cpp|c|h|hpp)$",
        "cmd": "cmake -P ${workspaceFolder}/buildscripts/tools/codestyle/format_file.cmake '${file}'"
      }
    ]
  }
}