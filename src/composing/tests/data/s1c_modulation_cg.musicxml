<!DOCTYPE score-partwise PUBLIC "-//Recordare//DTD MusicXML 3.1 Partwise//EN"
  "http://www.musicxml.org/dtds/partwise.dtd">
<!-- Layer-3 key/mode decoder fixture: a NOTE-BASED sustained modulation, NOT
     notated in the key signature (0 fifths throughout). Bars 1-4 are an
     unambiguous C major (the C-E-G triad with C in the bass, four times — no
     accidental, no low subdominant bass to confuse the window). Bars 5-8 are an
     unambiguous G major (G-B-D with a D-F#-A dominant; the F# leading tone rules
     out C major). The decoder, given the notated signature 0 (a weak hint only),
     must read C major for the first half and switch to G major for the second —
     a sustained modulation that repays the change cost. Whole-note root-position
     triads keep each local fit unambiguous and the tonic in the bass. -->
<score-partwise version="3.1">
  <part-list>
    <score-part id="P1">
      <part-name>Piano</part-name>
    </score-part>
  </part-list>
