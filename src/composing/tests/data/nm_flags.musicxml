<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE score-partwise PUBLIC "-//Recordare//DTD MusicXML 3.1 Partwise//EN"
  "http://www.musicxml.org/dtds/partwise.dtd">
<!-- Layer-1 note-model fixture T7: a chord C4 + E4 + G4(invisible,
     print-object="no") in voice 1, and a cue note B4 in voice 2 (imported
     play=false). The model must KEEP all notes, flagging G4 visible=false and
     the cue B4 plays=false, leaving the keep/drop decision downstream. (Cue and
     user-mute are indistinguishable post-import — both plays=false; see
     report.) -->
<score-partwise version="3.1">
  <part-list>
    <score-part id="P1">
      <part-name>Lead</part-name>
    </score-part>
  </part-list>
  <part id="P1">
    <measure number="1">
      <attributes>
        <divisions>1</divisions>
        <key><fifths>0</fifths></key>
        <time><beats>4</beats><beat-type>4</beat-type></time>
        <clef><sign>G</sign><line>2</line></clef>
      </attributes>
      <note>
        <pitch><step>C</step><octave>4</octave></pitch>
        <duration>1</duration><voice>1</voice><type>quarter</type>
      </note>
      <note>
        <chord/><pitch><step>E</step><octave>4</octave></pitch>
        <duration>1</duration><voice>1</voice><type>quarter</type>
        <notations/>
      </note>
      <note print-object="no">
        <chord/><pitch><step>G</step><octave>4</octave></pitch>
        <duration>1</duration><voice>1</voice><type>quarter</type>
      </note>
      <note>
        <rest/><duration>3</duration><voice>1</voice><type>half</type><dot/>
      </note>
      <backup><duration>4</duration></backup>
      <note>
        <cue/><pitch><step>B</step><octave>4</octave></pitch>
        <duration>1</duration><voice>2</voice><type>quarter</type>
      </note>
      <note>
        <rest/><duration>3</duration><voice>2</voice><type>half</type><dot/>
      </note>
    </measure>
  </part>
</score-partwise>
