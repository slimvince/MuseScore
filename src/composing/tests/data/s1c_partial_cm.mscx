    <Staff id="1">
      <Measure>
        <voice>
          <!-- Notated 2-flat (Dorian) signature, declared minor: true key C minor.
               Ab (pc 8) is pervasive and A-natural (pc 9) never sounds, so the
               partial-signature detector reinterprets -2 -> -3. -->
          <KeySig>
            <accidental>-2</accidental>
            <mode>minor</mode>
          </KeySig>
          <TimeSig>
            <sigN>4</sigN>
            <sigD>4</sigD>
          </TimeSig>
          <!-- M1: Cm  C4(60) Eb4(63) G4(67) — PCs {0,3,7} -->
          <Chord>
            <durationType>whole</durationType>
            <Note><pitch>60</pitch><tpc>14</tpc></Note>
            <Note><pitch>63</pitch><tpc>11</tpc></Note>
            <Note><pitch>67</pitch><tpc>15</tpc></Note>
          </Chord>
        </voice>
      </Measure>
      <Measure>
        <voice>
          <!-- M2: Ab major  Ab3(56) C4(60) Eb4(63) — PCs {8,0,3}, pervasive Ab -->
          <Chord>
            <durationType>whole</durationType>
            <Note><pitch>56</pitch><tpc>10</tpc></Note>
            <Note><pitch>60</pitch><tpc>14</tpc></Note>
            <Note><pitch>63</pitch><tpc>11</tpc></Note>
          </Chord>
        </voice>
      </Measure>
      <Measure>
        <voice>
          <!-- M3: Fm  F3(53) Ab3(56) C4(60) — PCs {5,8,0}, more Ab -->
          <Chord>
            <durationType>whole</durationType>
            <Note><pitch>53</pitch><tpc>13</tpc></Note>
            <Note><pitch>56</pitch><tpc>10</tpc></Note>
            <Note><pitch>60</pitch><tpc>14</tpc></Note>
          </Chord>
        </voice>
      </Measure>
      <Measure>
        <voice>
          <!-- M4: G major (V of C minor)  G3(55) B3(59) D4(62) — PCs {7,11,2} -->
          <Chord>
            <durationType>whole</durationType>
            <Note><pitch>55</pitch><tpc>15</tpc></Note>
            <Note><pitch>59</pitch><tpc>19</tpc></Note>
            <Note><pitch>62</pitch><tpc>16</tpc></Note>
          </Chord>
