# Normalise text files by default
*               text=auto

# Shell scripts with shebang lines must have LF line endings
*.sh            text            eol=lf
*.py            text            eol=lf
*.ps1           text            eol=lf
build.cmake     text            eol=lf

# Snapshot/test JSON goldens must stay LF: the pipeline snapshot test emits LF and
# compares byte-exact, so an autocrlf CRLF checkout makes the whole suite spuriously
# all-fail after any git checkout / worktree switch / bisect.
src/notation/tests/**/*.json  text  eol=lf

# Binary MuseScore scores (.mscz is a ZIP container) must NEVER be line-ending
# normalised — the default `* text=auto` above would corrupt the zip on a CRLF
# checkout (the OI-195 / OI-34 line-ending-normalisation class). Marked binary so
# git stores and checks them out byte-for-byte. (.mscx is uncompressed XML and is
# left under text=auto by design — only the committed .mscz set needs this.)
*.mscz          binary

# Batch files need CRLF line endings
*.bat           text            eol=crlf
*.cmd           text            eol=crlf

# Windows PortableApps packaging files need CRLF line endings
buildscripts/packaging/Windows/PortableApps/**/*.ini eol=crlf
buildscripts/packaging/Windows/PortableApps/**/*.txt eol=crlf
buildscripts/packaging/Windows/PortableApps/**/*.ini.in eol=crlf
buildscripts/packaging/Windows/PortableApps/**/*.html eol=crlf
